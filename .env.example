# OpenAI API Key (Primary LLM & Embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Fallback LLM)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API Key (Fallback LLM)
GOOGLE_API_KEY=your_google_api_key_here

# Database Configuration (sqlite for dev, postgresql for prod)
DATABASE_URL=sqlite:///./insight.db
# DATABASE_URL=postgresql://user:password@localhost:5432/insightdb

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_data
